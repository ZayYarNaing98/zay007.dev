{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zay007-dev",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Run the Worker first so it can redirect workers.dev → zayarnaing.com
    "run_worker_first": true
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "zayarnaing.com", "custom_domain": true },
    { "pattern": "www.zayarnaing.com", "custom_domain": true }
  ],
  // Page-view counter (views-counter/ Worker), called over RPC from /api/views.
  "services": [{ "binding": "VIEWS", "service": "views-counter" }],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}

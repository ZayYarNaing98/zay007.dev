{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zay007-dev",
  "compatibility_date": "2026-05-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "zayarnaing.com", "custom_domain": true },
    { "pattern": "www.zayarnaing.com", "custom_domain": true }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
